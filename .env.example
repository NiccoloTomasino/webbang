# Invio email delle richieste (modulo Sconto 60% e contatti) tramite Resend — https://resend.com
# Senza queste variabili, in sviluppo le richieste vengono solo stampate in console;
# in produzione il modulo mostra un errore invece di perdere la richiesta.
RESEND_API_KEY=
# Uno o più destinatari separati da virgola
CONTACT_TO_EMAIL=info@webbang.it
# Mittente verificato su Resend
CONTACT_FROM_EMAIL="Webbang <noreply@webbang.it>"
